# hp-kernel.config — фрагмент конфига ядра под HP (AMD A10-5745M, Richland + Topaz R7 M260)
# Накладывается поверх defconfig через scripts/kconfig/merge_config.sh

# ---- Загрузка без initramfs: диск, ФС и EFI вшиваем в ядро (=y) ----
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ---- USB (клавиатура, мышь, флешки): контроллеры XHCI + EHCI + OHCI ----
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_STORAGE=m
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# ---- Клавиатура и тачпад (в lsmod был psmouse, т.е. PS/2) ----
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_ELANTECH=y

# ---- Графика: iGPU Radeon HD 8610G -> radeon, dGPU R7 M260 (Topaz) -> amdgpu ----
CONFIG_DRM=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---- Сеть: Ethernet RTL810xE, Wi-Fi RTL8723BE, Bluetooth Realtek (USB) ----
CONFIG_R8169=m
CONFIG_REALTEK_PHY=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RTLWIFI=m
CONFIG_RTL8723BE=m
CONFIG_RFKILL=y
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y

# ---- Звук: HDA (ALC269 + HDMI-аудио AMD) ----
CONFIG_SND=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_ALC269=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_HDMI_ATI=m

# ---- Веб-камера (uvcvideo) и картридер Realtek ----
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_MISC_RTSX_PCI=m
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_REALTEK_PCI=m

# ---- Платформа: HP, температура и частоты AMD, SMBus, AES-NI ----
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_ACPI_WMI=y
CONFIG_HP_WMI=m
CONFIG_WIRELESS_HOTKEY=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_X86_ACPI_CPUFREQ=m
CONFIG_I2C_PIIX4=m
CONFIG_CRYPTO_AES_NI_INTEL=m

# ---- Требования systemd ----
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUPS=y
CONFIG_FHANDLE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_DMIID=y
CONFIG_IPV6=y
CONFIG_BLK_DEV_BSG=y
CONFIG_CRYPTO_USER_API_HASH=y

# ---- iwd (Wi-Fi): ядерная криптография через AF_ALG и ключи ----
# Список из документации iwd; без этого iwd не подключится к WPA2/WPA3
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_ENABLE_OBSOLETE=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_ARC4=y

# ---- Сетевые карты для тестов в QEMU (на железе не мешают) ----
# Сейчас приходят из defconfig, но фиксируем явно, чтобы тесты не сломались
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_E1000=y

# ---- Экран с первых секунд загрузки (07.11) ----
# Картинка от UEFI (GOP) через simpledrm, пока не загрузился radeon/amdgpu; без этого экран чёрный до модуля
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# ---- Docker: контейнеры Navidrome, Immich и др. (07.11) ----
# Test 12: docker.service падал. Ограничение ресурсов контейнеров (cgroup v2)
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_POSIX_MQUEUE=y
# Файловая система слоёв образов
CONFIG_OVERLAY_FS=y
# Сеть контейнеров: виртуальные пары, мост docker0
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
CONFIG_DUMMY=m
# NAT и проброс портов (iptables и nftables)
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MARK=y
# С 6.17 таблицы iptables-legacy (filter/nat/mangle) скрыты за этими опциями, без них Docker не стартует
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_COMPAT=y
# Throne (прокси, режим TUN) — без tun-устройства не поднимается, а через него ходит Claude
CONFIG_TUN=y
CONFIG_IPV6_MULTIPLE_TABLES=y
# sshfs, AppImage, порталы flatpak
CONFIG_FUSE_FS=y
# флешка Ventoy размечена в exFAT
CONFIG_EXFAT_FS=y
